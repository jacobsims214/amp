{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "amp-manager": {
      "mode": "primary",
      "description": "AMP manager — plans work, creates Odoo tickets, dispatches sub-agents, monitors progress",
      "prompt": "{file:./prompts/amp-manager.txt}",
      "model": "anthropic/claude-sonnet-4-20250514",
      "temperature": 0.2,
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "webfetch": "allow"
      }
    },
    "amp-worker": {
      "mode": "subagent",
      "description": "AMP worker — executes a single assigned Odoo task, updates ticket state via MCP throughout",
      "prompt": "{file:./prompts/amp-worker.txt}",
      "model": "anthropic/claude-sonnet-4-20250514",
      "temperature": 0.1,
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "webfetch": "allow"
      }
    }
  },
  "mcp": {
    "amp-odoo": {
      "type": "remote",
      "url": "http://localhost:8000/sse",
      "enabled": true
    }
  }
}
