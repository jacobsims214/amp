<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- ── List view ──────────────────────────────────────────────────── -->
        <record id="view_amp_knowledge_entry_list" model="ir.ui.view">
            <field name="name">amp.knowledge.entry.list</field>
            <field name="model">amp.knowledge.entry</field>
            <field name="arch" type="xml">
                <list string="Knowledge Base" multi_edit="1">
                    <field name="title" string="Title"/>
                    <field name="entry_type" widget="badge" decoration-info="entry_type == 'context'" decoration-success="entry_type == 'howto'" decoration-warning="entry_type == 'decision'" decoration-danger="entry_type == 'issue'"/>
                    <field name="content_text" string="Content Preview" optional="show" limit="100"/>
                    <field name="project_id" optional="show"/>
                    <field name="epic_id" optional="hide"/>
                    <field name="story_id" optional="hide"/>
                    <field name="task_id" optional="hide"/>
                    <field name="tags" optional="show"/>
                    <field name="created_by_agent" optional="show"/>
                    <field name="create_date" string="Created" optional="show"/>
                </list>
            </field>
        </record>

        <!-- ── Form view ──────────────────────────────────────────────────── -->
        <record id="view_amp_knowledge_entry_form" model="ir.ui.view">
            <field name="name">amp.knowledge.entry.form</field>
            <field name="model">amp.knowledge.entry</field>
            <field name="arch" type="xml">
                <form string="Knowledge Entry">
                    <header>
                        <button name="action_view_related" string="View Linked Item" type="object" 
                                class="btn-primary" invisible="not project_id"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_related" type="object" class="oe_stat_button" icon="fa-external-link"
                                    invisible="not task_id">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">View</span>
                                    <span class="o_stat_text">Task</span>
                                </div>
                            </button>
                            <button name="action_view_related" type="object" class="oe_stat_button" icon="fa-external-link"
                                    invisible="task_id or not story_id">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">View</span>
                                    <span class="o_stat_text">Story</span>
                                </div>
                            </button>
                            <button name="action_view_related" type="object" class="oe_stat_button" icon="fa-external-link"
                                    invisible="task_id or story_id or not epic_id">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">View</span>
                                    <span class="o_stat_text">Epic</span>
                                </div>
                            </button>
                            <button name="action_view_related" type="object" class="oe_stat_button" icon="fa-external-link"
                                    invisible="task_id or story_id or epic_id or not project_id">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">View</span>
                                    <span class="o_stat_text">Project</span>
                                </div>
                            </button>
                            <!-- Knowledge Discovery -->
                            <button name="action_view_related_entries" type="object" class="oe_stat_button" icon="fa-lightbulb-o">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">Related</span>
                                    <span class="o_stat_text">Entries</span>
                                </div>
                            </button>
                        </div>
                        <div class="oe_title">
                            <label for="title" class="oe_edit_only"/>
                            <h1>
                                <field name="title" placeholder="Short, searchable title…"/>
                            </h1>
                            <field name="entry_type" widget="badge" class="oe_inline"/>
                        </div>
                        <group>
                            <group string="Classification">
                                <field name="tags" placeholder="Add tags separated by commas (e.g., odoo19, manifest, assets)"/>
                                <field name="created_by_agent" readonly="1"/>
                            </group>
                            <group string="Linked To">
                                <field name="project_id" options="{'no_create': True}"/>
                                <field name="epic_id"
                                       domain="[('project_id', '=', project_id)]"
                                       invisible="not project_id"
                                       options="{'no_create': True}"/>
                                <field name="story_id"
                                       domain="[('epic_id', '=', epic_id)]"
                                       invisible="not epic_id"
                                       options="{'no_create': True}"/>
                                <field name="task_id"
                                       domain="[('story_id', '=', story_id)]"
                                       invisible="not story_id"
                                       options="{'no_create': True}"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Content" name="content">
                                <field name="content" widget="markdown" placeholder="Enter your knowledge content using markdown..."/>
                            </page>
                            <page string="Plain Text Preview" name="preview">
                                <field name="content_text" readonly="1" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- ── Search view ────────────────────────────────────────────────── -->
        <record id="view_amp_knowledge_entry_search" model="ir.ui.view">
            <field name="name">amp.knowledge.entry.search</field>
            <field name="model">amp.knowledge.entry</field>
            <field name="arch" type="xml">
                <search string="Search Knowledge">
                    <field name="title"
                           filter_domain="['|', '|', ('title', 'ilike', self), ('content_text', 'ilike', self), ('tags', 'ilike', self)]"
                           string="Title / Content / Tags"/>
                    <field name="project_id"/>
                    <field name="epic_id"/>
                    <field name="story_id"/>
                    <field name="task_id"/>
                    <field name="created_by_agent"/>
                    <field name="tags"/>
                    <separator/>
                    <filter string="My Entries" name="my_entries" domain="[('created_by_agent', '=', 'amp-worker')]"/>
                    <filter string="Today" name="today" domain="[('create_date', '&gt;=', context_today())]"/>
                    <separator/>
                    <filter string="Decisions"  name="decisions"  domain="[('entry_type', '=', 'decision')]"/>
                    <filter string="Findings"   name="findings"   domain="[('entry_type', '=', 'finding')]"/>
                    <filter string="How-Tos"    name="howto"      domain="[('entry_type', '=', 'howto')]"/>
                    <filter string="Issues"     name="issues"     domain="[('entry_type', '=', 'issue')]"/>
                    <filter string="Context"    name="context"    domain="[('entry_type', '=', 'context')]"/>
                    <filter string="Reference"  name="reference"  domain="[('entry_type', '=', 'reference')]"/>
                    <separator/>
                    <filter string="Linked to Tasks" name="has_task" domain="[('task_id', '!=', False)]"/>
                    <filter string="Linked to Stories" name="has_story" domain="[('story_id', '!=', False)]"/>
                    <filter string="Linked to Epics" name="has_epic" domain="[('epic_id', '!=', False)]"/>
                    <filter string="Project Level" name="project_level" domain="[('task_id', '=', False), ('story_id', '=', False), ('epic_id', '=', False)]"/>
                    <group>
                        <filter string="Project"  name="by_project" domain="[]" context="{'group_by': 'project_id'}"/>
                        <filter string="Type"     name="by_type"    domain="[]" context="{'group_by': 'entry_type'}"/>
                        <filter string="Agent"    name="by_agent"   domain="[]" context="{'group_by': 'created_by_agent'}"/>
                        <filter string="Epic"     name="by_epic"    domain="[]" context="{'group_by': 'epic_id'}"/>
                        <filter string="Story"    name="by_story"   domain="[]" context="{'group_by': 'story_id'}"/>
                        <filter string="Creation Date" name="by_date" domain="[]" context="{'group_by': 'create_date:month'}"/>
                    </group>
                    <group>
                        <filter string="Most Recent" name="sort_recent" domain="[]" context="{'order': 'create_date desc'}"/>
                        <filter string="Oldest First" name="sort_oldest" domain="[]" context="{'order': 'create_date asc'}"/>
                        <filter string="Title A-Z" name="sort_title_asc" domain="[]" context="{'order': 'title asc'}"/>
                        <filter string="Title Z-A" name="sort_title_desc" domain="[]" context="{'order': 'title desc'}"/>
                        <filter string="By Type" name="sort_type" domain="[]" context="{'order': 'entry_type, title'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ── Kanban view ─────────────────────────────────────────────────── -->
        <record id="view_amp_knowledge_entry_kanban" model="ir.ui.view">
            <field name="name">amp.knowledge.entry.kanban</field>
            <field name="model">amp.knowledge.entry</field>
            <field name="arch" type="xml">
                <kanban default_group_by="entry_type" class="o_kanban_small_column">
                    <field name="id"/>
                    <field name="title"/>
                    <field name="entry_type"/>
                    <field name="content_text"/>
                    <field name="tags"/>
                    <field name="project_id"/>
                    <field name="epic_id"/>
                    <field name="story_id"/>
                    <field name="task_id"/>
                    <field name="created_by_agent"/>
                    <field name="create_date"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="title"/>
                                            </strong>
                                        </div>
                                        <div class="o_kanban_record_top_right">
                                            <span t-if="record.task_id.raw_value" class="badge badge-info">Task</span>
                                            <span t-elif="record.story_id.raw_value" class="badge badge-secondary">Story</span>
                                            <span t-elif="record.epic_id.raw_value" class="badge badge-primary">Epic</span>
                                            <span t-elif="record.project_id.raw_value" class="badge badge-success">Project</span>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <field name="content_text" limit="150"/>
                                    </div>
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_left">
                                            <span t-if="record.tags.raw_value" class="text-muted">
                                                <i class="fa fa-tags"/> <t t-esc="record.tags.value"/>
                                            </span>
                                        </div>
                                        <div class="oe_kanban_bottom_right">
                                            <span class="text-muted" t-esc="record.created_by_agent.value"/>
                                            <br/>
                                            <span class="text-muted" t-esc="moment(record.create_date.raw_value).format('MMM DD')"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ── Window action ──────────────────────────────────────────────── -->
        <record id="action_amp_knowledge_entry" model="ir.actions.act_window">
            <field name="name">Knowledge Base</field>
            <field name="res_model">amp.knowledge.entry</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="search_view_id" ref="view_amp_knowledge_entry_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No knowledge entries yet</p>
                <p>Agents write here when they discover something worth sharing:
                   decisions, patterns, gotchas, how-tos.</p>
                <p>Click <strong>Create</strong> to add your first knowledge entry.</p>
            </field>
        </record>

    </data>
</odoo>
