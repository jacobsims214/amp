<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Epic List View -->
        <record id="view_amp_epic_tree" model="ir.ui.view">
            <field name="name">amp.epic.list</field>
            <field name="model">amp.epic</field>
            <field name="arch" type="xml">
                <list string="Epics"
                      decoration-success="state == 'completed'"
                      decoration-info="state == 'in_progress'"
                      decoration-muted="state == 'blocked'">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="project_id"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'completed'"
                           decoration-info="state == 'in_progress'"
                           decoration-danger="state == 'blocked'"
                           decoration-muted="state == 'backlog'"/>
                    <field name="story_count" string="Stories"/>
                    <field name="completed_story_count" string="Done"/>
                    <field name="task_count" string="Tasks"/>
                    <field name="progress_percentage" widget="progressbar"/>
                    <field name="priority" widget="priority"/>
                </list>
            </field>
        </record>

        <!-- Epic Form View -->
        <record id="view_amp_epic_form" model="ir.ui.view">
            <field name="name">amp.epic.form</field>
            <field name="model">amp.epic</field>
            <field name="arch" type="xml">
                <form string="Epic">
                    <header>
                        <button name="action_start" string="Start Epic" type="object"
                                class="oe_highlight" invisible="state != 'backlog'"/>
                        <button name="action_complete" string="Complete" type="object"
                                class="oe_highlight" invisible="state in ('backlog', 'completed')"/>
                        <button name="action_block" string="Block" type="object"
                                class="btn-warning" invisible="state in ('blocked', 'completed')"/>
                        <button name="action_unblock" string="Unblock" type="object"
                                class="btn-success" invisible="state != 'blocked'"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="backlog,in_progress,completed"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_stories" type="object"
                                    class="oe_stat_button" icon="fa-list-alt">
                                <field name="story_count" widget="statinfo" string="Stories"/>
                            </button>
                            <button name="action_view_knowledge" type="object"
                                    class="oe_stat_button" icon="fa-book">
                                <span class="o_stat_text">Knowledge</span>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="Epic Name"/></h1>
                        </div>
                        <group>
                            <group string="Details">
                                <field name="project_id" options="{'no_create': True}"/>
                                <field name="priority" widget="priority"/>
                                <field name="sequence"/>
                            </group>
                            <group string="Progress">
                                <field name="progress_percentage" widget="progressbar"/>
                                <field name="story_count" string="Total Stories"/>
                                <field name="completed_story_count" string="Completed Stories"/>
                                <field name="task_count" string="Total Tasks"/>
                                <field name="completed_task_count" string="Completed Tasks"/>
                            </group>
                        </group>
                        <group string="Description">
                            <field name="description" nolabel="1"/>
                        </group>
                        <notebook>
                            <page string="Stories" name="stories">
                                <field name="story_ids"
                                       context="{'default_epic_id': id, 'default_project_id': project_id}">
                                    <list>
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="state" widget="badge"
                                               decoration-success="state == 'completed'"
                                               decoration-info="state == 'in_progress'"
                                               decoration-danger="state == 'blocked'"/>
                                        <field name="task_count"/>
                                        <field name="completed_task_count"/>
                                        <field name="progress_percentage" widget="progressbar"/>
                                        <field name="priority" widget="priority"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Epic Kanban View -->
        <record id="view_amp_epic_kanban" model="ir.ui.view">
            <field name="name">amp.epic.kanban</field>
            <field name="model">amp.epic</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state">
                    <field name="name"/>
                    <field name="state"/>
                    <field name="project_id"/>
                    <field name="story_count"/>
                    <field name="task_count"/>
                    <field name="completed_task_count"/>
                    <field name="progress_percentage"/>
                    <field name="priority"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <span class="float-end">
                                        <field name="priority" widget="priority"/>
                                    </span>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div class="mt-2">
                                        <span class="badge bg-primary"><field name="story_count"/> Stories</span>
                                        <span class="badge bg-info"><field name="task_count"/> Tasks</span>
                                        <span class="badge bg-success" t-if="record.completed_task_count.value > 0">
                                            <field name="completed_task_count"/> Done
                                        </span>
                                    </div>
                                    <div class="mt-2">
                                        <field name="progress_percentage" widget="progressbar"/>
                                    </div>
                                    <div class="mt-2 text-muted">
                                        <field name="project_id"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Epic Search View -->
        <record id="view_amp_epic_search" model="ir.ui.view">
            <field name="name">amp.epic.search</field>
            <field name="model">amp.epic</field>
            <field name="arch" type="xml">
                <search string="Search Epics">
                    <field name="name"/>
                    <field name="project_id"/>
                    <filter string="Backlog"     name="backlog"      domain="[('state', '=', 'backlog')]"/>
                    <filter string="In Progress" name="in_progress"  domain="[('state', '=', 'in_progress')]"/>
                    <filter string="Completed"   name="completed"    domain="[('state', '=', 'completed')]"/>
                    <filter string="Blocked"     name="blocked"      domain="[('state', '=', 'blocked')]"/>
                    <separator/>
                     <filter string="Hide Done" name="hide_done" domain="[('state', '!=', 'completed')]"/>
                    <separator/>
                    <filter string="High Priority" name="high_priority" domain="[('priority', 'in', ['2', '3'])]"/>
                    <group>
                        <filter string="Project"  name="group_project"  domain="[]" context="{'group_by': 'project_id'}"/>
                        <filter string="State"    name="group_state"    domain="[]" context="{'group_by': 'state'}"/>
                        <filter string="Priority" name="group_priority" domain="[]" context="{'group_by': 'priority'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Epic Action -->
        <record id="action_amp_epic" model="ir.actions.act_window">
            <field name="name">Epics</field>
            <field name="res_model">amp.epic</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="search_view_id" ref="view_amp_epic_search"/>
        </record>
    </data>
</odoo>
