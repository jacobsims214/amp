<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- AMP Project Tree View -->
        <record id="view_amp_project_tree" model="ir.ui.view">
            <field name="name">amp.project.tree</field>
            <field name="model">amp.project</field>
            <field name="arch" type="xml">
                <list string="AMP Projects" decoration-muted="state == 'archived'" decoration-info="state == 'active'" decoration-success="progress_percentage == 100">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="state" widget="badge" decoration-success="state == 'active'" decoration-muted="state == 'archived'" decoration-warning="state == 'draft'"/>
                    <field name="epic_count" string="Epics"/>
                    <field name="story_count" string="Stories"/>
                    <field name="task_count" string="Tasks"/>
                    <field name="completed_task_count" string="Done"/>
                    <field name="blocked_task_count" string="Blocked"/>
                    <field name="progress_percentage" widget="progressbar"/>
                    <field name="active_agent_count" string="Agents"/>
                    <field name="last_session" string="Last Activity"/>
                </list>
            </field>
        </record>
        
        <!-- AMP Project Form View -->
        <record id="view_amp_project_form" model="ir.ui.view">
            <field name="name">amp.project.form</field>
            <field name="model">amp.project</field>
            <field name="arch" type="xml">
                <form string="AMP Project">
                    <header>
                        <button name="action_activate" string="Activate" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                        <button name="action_archive" string="Archive" type="object" invisible="state == 'archived'"/>
                        <button name="action_sync_session" string="Sync Session" type="object"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,active,archived"/>
                    </header>
                    <sheet>
                        <!-- Breadcrumb Navigation -->
                        <div class="o_amp_breadcrumb mb-3">
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item">
                                        <a href="#" onclick="window.location.href='/web#action=amp_project.action_amp_live_board'">
                                            <i class="fa fa-bolt"></i> Live Board
                                        </a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="#" onclick="window.location.href='/web#action=amp_project.action_amp_project'">
                                            <i class="fa fa-folder"></i> Projects
                                        </a>
                                    </li>
                                    <li class="breadcrumb-item active" aria-current="page">
                                        <field name="name" readonly="1"/>
                                    </li>
                                </ol>
                            </nav>
                        </div>
                        <div class="oe_button_box" name="button_box">
                            <!-- Quick Navigation to Live Board -->
                            <button name="%(action_amp_live_board)d" type="action" class="oe_stat_button" icon="fa-bolt" style="background: linear-gradient(135deg, #7c3aed, #a855f7);">
                                <span class="o_stat_text" style="color: white;">Live Board</span>
                            </button>
                            <!-- Work Items -->
                            <button name="action_view_epics" type="object" class="oe_stat_button" icon="fa-sitemap">
                                <field name="epic_count" widget="statinfo" string="Epics"/>
                            </button>
                            <button name="%(action_amp_story)d" type="action" class="oe_stat_button" icon="fa-list-alt" context="{'search_default_project_id': id}">
                                <field name="story_count" widget="statinfo" string="Stories"/>
                            </button>
                            <button name="%(action_amp_task)d" type="action" class="oe_stat_button" icon="fa-tasks" context="{'search_default_project_id': id}">
                                <field name="task_count" widget="statinfo" string="Tasks"/>
                            </button>
                            <!-- Progress Indicators -->
                            <button name="%(action_amp_task)d" type="action" class="oe_stat_button" icon="fa-check-circle" context="{'search_default_project_id': id, 'search_default_state': 'completed'}">
                                <field name="completed_task_count" widget="statinfo" string="Completed"/>
                            </button>
                            <button name="%(action_amp_task)d" type="action" class="oe_stat_button" icon="fa-exclamation-triangle" context="{'search_default_project_id': id, 'search_default_state': 'blocked'}">
                                <field name="blocked_task_count" widget="statinfo" string="Blocked"/>
                            </button>
                            <!-- Knowledge Base -->
                            <button name="action_view_knowledge" type="object" class="oe_stat_button" icon="fa-book">
                                <span class="o_stat_text">Knowledge</span>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Project Name"/>
                            </h1>
                            <h2>
                                <field name="code" placeholder="project-code"/>
                            </h2>
                        </div>
                        <group>
                            <group string="Project Details">
                                <field name="description" nolabel="1"/>
                            </group>
                            <group string="Progress Overview">
                                <field name="progress_percentage" widget="progressbar"/>
                                <field name="completed_task_count" string="Completed Tasks"/>
                                <field name="blocked_task_count" string="Blocked Tasks"/>
                                <field name="active_agent_count"/>
                                <field name="last_session"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Epics" name="epics">
                                <field name="epic_ids" context="{'default_project_id': id}">
                                    <list>
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="state" widget="badge" decoration-success="state == 'completed'" decoration-info="state == 'in_progress'" decoration-danger="state == 'blocked'"/>
                                        <field name="story_count"/>
                                        <field name="task_count"/>
                                        <field name="progress_percentage" widget="progressbar"/>
                                        <field name="priority" widget="priority"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Activity Log" name="activity">
                                <field name="message_ids" widget="mail_thread"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        
        <!-- AMP Project Kanban View -->
        <record id="view_amp_project_kanban" model="ir.ui.view">
            <field name="name">amp.project.kanban</field>
            <field name="model">amp.project</field>
            <field name="arch" type="xml">
                <kanban class="o_amp_project_kanban">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="state"/>
                    <field name="epic_count"/>
                    <field name="story_count"/>
                    <field name="task_count"/>
                    <field name="completed_task_count"/>
                    <field name="blocked_task_count"/>
                    <field name="progress_percentage"/>
                    <field name="active_agent_count"/>
                    <templates>
                        <t t-name="card">
                            <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <span class="float-end">
                                        <field name="state" widget="badge" decoration-success="state == 'active'" decoration-muted="state == 'archived'"/>
                                    </span>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div>
                                        <span t-if="record.code.value" class="text-muted">[<field name="code"/>]</span>
                                    </div>
                                    <div class="mt-2">
                                        <span class="badge bg-primary"><field name="epic_count"/> Epics</span>
                                        <span class="badge bg-info"><field name="story_count"/> Stories</span>
                                        <span class="badge bg-secondary"><field name="task_count"/> Tasks</span>
                                    </div>
                                    <div class="mt-2">
                                        <span class="badge bg-success" t-if="record.completed_task_count.value > 0"><field name="completed_task_count"/> Done</span>
                                        <span class="badge bg-warning" t-if="record.blocked_task_count.value > 0"><field name="blocked_task_count"/> Blocked</span>
                                    </div>
                                    <div class="mt-2">
                                        <field name="progress_percentage" widget="progressbar"/>
                                    </div>
                                    <div class="mt-2" t-if="record.active_agent_count.value > 0">
                                        <i class="fa fa-robot"></i> <field name="active_agent_count"/> Active Agents
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        
        <!-- AMP Project Search View -->
        <record id="view_amp_project_search" model="ir.ui.view">
            <field name="name">amp.project.search</field>
            <field name="model">amp.project</field>
            <field name="arch" type="xml">
                <search string="Search AMP Projects">
                    <field name="name"/>
                    <field name="code"/>
                    <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Archived" name="archived" domain="[('state', '=', 'archived')]"/>
                </search>
            </field>
        </record>
        
        <!-- Action for Projects -->
        <record id="action_amp_project" model="ir.actions.act_window">
            <field name="name">AMP Projects</field>
            <field name="res_model">amp.project</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="search_view_id" ref="view_amp_project_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first AMP Project
                </p>
                <p>
                    Projects are the root container for your agent-managed work.
                </p>
            </field>
        </record>
    </data>
</odoo>
