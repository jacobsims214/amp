<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- ── Task List View ─────────────────────────────────────────────── -->
        <record id="view_amp_task_tree" model="ir.ui.view">
            <field name="name">amp.task.list</field>
            <field name="model">amp.task</field>
            <field name="arch" type="xml">
                <list string="Tasks"
                      decoration-success="state == 'completed'"
                      decoration-info="state == 'in_progress'"
                      decoration-warning="state == 'review'"
                      decoration-danger="state == 'blocked'">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="project_id" optional="hide"/>
                    <field name="story_id" optional="show"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'completed'"
                           decoration-info="state == 'in_progress'"
                           decoration-warning="state == 'review'"
                           decoration-danger="state == 'blocked'"
                           decoration-muted="state == 'backlog'"/>
                    <field name="agent_id" optional="show"/>
                    <field name="dag_level" optional="show"/>
                    <field name="priority" widget="priority"/>
                </list>
            </field>
        </record>

        <!-- ── Simple list for dependency inline views ───────────────────── -->
        <record id="view_amp_task_tree_simple" model="ir.ui.view">
            <field name="name">amp.task.list.simple</field>
            <field name="model">amp.task</field>
            <field name="arch" type="xml">
                <list string="Tasks"
                      decoration-success="state == 'completed'"
                      decoration-danger="state == 'blocked'">
                    <field name="name"/>
                    <field name="state" widget="badge"/>
                    <field name="dag_level"/>
                    <field name="agent_id"/>
                </list>
            </field>
        </record>

        <!-- ── Task Form View ─────────────────────────────────────────────── -->
        <record id="view_amp_task_form" model="ir.ui.view">
            <field name="name">amp.task.form</field>
            <field name="model">amp.task</field>
            <field name="arch" type="xml">
                <form string="Task">
                    <header>
                        <button name="action_dispatch" string="Dispatch to Agent" type="object"
                                class="oe_highlight"
                                invisible="state != 'backlog'"/>
                        <button name="action_mark_review" string="Submit for Review" type="object"
                                invisible="state != 'in_progress'"/>
                        <button name="action_complete" string="Mark Complete" type="object"
                                class="oe_highlight"
                                invisible="state in ('completed', 'blocked')"/>
                        <button name="action_return_to_backlog" string="Return to Backlog" type="object"
                                invisible="state not in ('in_progress', 'review')"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="backlog,in_progress,review,completed"/>
                    </header>

                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_knowledge" type="object"
                                    class="oe_stat_button" icon="fa-book">
                                <span class="o_stat_text">Knowledge</span>
                            </button>
                            <button class="oe_stat_button" icon="fa-link">
                                <field name="dependency_count" widget="statinfo" string="Depends On"/>
                            </button>
                            <button class="oe_stat_button" icon="fa-chain-broken">
                                <field name="blocked_count" widget="statinfo" string="Blocks"/>
                            </button>
                        </div>

                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Task Name"/>
                            </h1>
                            <div invisible="not agent_id" class="mt-1">
                                <span class="badge text-bg-info">
                                    Agent: <field name="agent_id"/>
                                </span>
                            </div>
                        </div>

                        <!-- Metadata row -->
                        <group>
                            <group string="Location">
                                <field name="project_id" options="{'no_create': True}"/>
                                <field name="epic_id"
                                       domain="[('project_id', '=', project_id)]"
                                       options="{'no_create': True}"
                                       invisible="not project_id"/>
                                <field name="story_id"
                                       domain="[('epic_id', '=', epic_id)]"
                                       options="{'no_create': True}"
                                       invisible="not epic_id"/>
                            </group>
                            <group string="Properties">
                                <field name="priority" widget="priority"/>
                                <field name="planned_hours"/>
                                <field name="dag_level"/>
                                <field name="dag_critical_path" widget="boolean"/>
                                <field name="dispatch_time" readonly="1"
                                       invisible="not dispatch_time"/>
                                <field name="completion_time" readonly="1"
                                       invisible="not completion_time"/>
                            </group>
                        </group>

                        <!-- Instructions — the main content, always visible -->
                        <group string="Instructions">
                            <field name="description" widget="html" nolabel="1"/>
                        </group>

                        <group string="Acceptance Criteria" invisible="not acceptance_criteria">
                            <field name="acceptance_criteria" nolabel="1"/>
                        </group>

                        <!-- Dependencies — only show if they exist -->
                        <group string="Depends On" invisible="dependency_count == 0">
                            <field name="dependency_ids" nolabel="1"
                                   domain="[('project_id', '=', project_id), ('id', '!=', id)]">
                                <list>
                                    <field name="name"/>
                                    <field name="state" widget="badge"/>
                                    <field name="agent_id"/>
                                </list>
                            </field>
                        </group>

                        <group string="Blocks" invisible="blocked_count == 0">
                            <field name="blocked_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="state" widget="badge"/>
                                    <field name="agent_id"/>
                                </list>
                            </field>
                        </group>

                        <!-- Agent context — only show if dispatched -->
                        <group string="Agent Context" invisible="not context_data">
                            <field name="agent_session" readonly="1" invisible="not agent_session"/>
                            <field name="context_data" widget="text" readonly="1" nolabel="1"/>
                        </group>
                    </sheet>

                    <!-- Chatter — agent notes, comments, history -->
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- ── Task Kanban View ───────────────────────────────────────────── -->
        <record id="view_amp_task_kanban" model="ir.ui.view">
            <field name="name">amp.task.kanban</field>
            <field name="model">amp.task</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state">
                    <field name="name"/>
                    <field name="state"/>
                    <field name="agent_id"/>
                    <field name="dag_level"/>
                    <field name="dag_critical_path"/>
                    <field name="priority"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <field name="priority" widget="priority"/>
                                </div>
                                <div class="o_kanban_record_body">
                                    <span t-if="record.agent_id.value" class="badge text-bg-info">
                                        <field name="agent_id"/>
                                    </span>
                                    <span t-if="record.dag_critical_path.raw_value" class="badge text-bg-warning">
                                        ⚡ Critical
                                    </span>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ── Task Search View ──────────────────────────────────────────── -->
        <record id="view_amp_task_search" model="ir.ui.view">
            <field name="name">amp.task.search</field>
            <field name="model">amp.task</field>
            <field name="arch" type="xml">
                <search string="Search Tasks">
                    <field name="name"/>
                    <field name="project_id"/>
                    <field name="story_id"/>
                    <field name="agent_id"/>
                    <filter string="Backlog"     name="backlog"      domain="[('state', '=', 'backlog')]"/>
                    <filter string="In Progress" name="in_progress"  domain="[('state', '=', 'in_progress')]"/>
                    <filter string="Review"      name="review"       domain="[('state', '=', 'review')]"/>
                    <filter string="Completed"   name="completed"    domain="[('state', '=', 'completed')]"/>
                    <filter string="Blocked"     name="blocked"      domain="[('state', '=', 'blocked')]"/>
                    <separator/>
                    <filter string="Critical Path" name="critical"      domain="[('dag_critical_path', '=', True)]"/>
                    <filter string="High Priority" name="high_priority" domain="[('priority', 'in', ['2', '3'])]"/>
                    <group>
                        <filter string="Project" name="by_project" domain="[]" context="{'group_by': 'project_id'}"/>
                        <filter string="Story"   name="by_story"   domain="[]" context="{'group_by': 'story_id'}"/>
                        <filter string="State"   name="by_state"   domain="[]" context="{'group_by': 'state'}"/>
                        <filter string="Agent"   name="by_agent"   domain="[]" context="{'group_by': 'agent_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ── Task Action ───────────────────────────────────────────────── -->
        <record id="action_amp_task" model="ir.actions.act_window">
            <field name="name">Tasks</field>
            <field name="res_model">amp.task</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_amp_task_search"/>
        </record>

    </data>
</odoo>
