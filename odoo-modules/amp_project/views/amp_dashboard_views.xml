<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Dashboard Form View (for individual project) -->
        <record id="view_amp_project_dashboard" model="ir.ui.view">
            <field name="name">amp.project.dashboard</field>
            <field name="model">amp.project</field>
            <field name="arch" type="xml">
                <form string="AMP Dashboard">
                    <sheet>
                        <div class="o_amp_dashboard">
                            <h1 class="text-center mb-4">
                                <field name="name"/> - Dashboard
                            </h1>
                            
                            <!-- Stats Row -->
                            <div class="row mb-4">
                                <div class="col-3">
                                    <div class="card text-center">
                                        <div class="card-body">
                                            <h3 class="card-title"><field name="epic_count"/></h3>
                                            <p class="card-text">Epics</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-3">
                                    <div class="card text-center">
                                        <div class="card-body">
                                            <h3 class="card-title"><field name="story_count"/></h3>
                                            <p class="card-text">Stories</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-3">
                                    <div class="card text-center">
                                        <div class="card-body">
                                            <h3 class="card-title"><field name="task_count"/></h3>
                                            <p class="card-text">Total Tasks</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-3">
                                    <div class="card text-center">
                                        <div class="card-body">
                                            <h3 class="card-title"><field name="active_agent_count"/></h3>
                                            <p class="card-text">Active Agents</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Progress -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <div class="card">
                                        <div class="card-body">
                                            <h5>Overall Progress</h5>
                                            <field name="progress_percentage" widget="progressbar" options="{'editable': false}"/>
                                            <p class="mt-2">
                                                <field name="completed_task_count"/> of <field name="task_count"/> tasks completed
                                                (<field name="blocked_task_count"/> blocked)
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Quick Actions -->
                            <div class="row">
                                <div class="col-12">
                                    <div class="card">
                                        <div class="card-body">
                                            <h5>Quick Actions</h5>
                                            <button name="action_view_epics" type="object" class="btn btn-primary me-2">
                                                <i class="fa fa-sitemap"></i> View Epics
                                            </button>
                                            <button name="action_sync_session" type="object" class="btn btn-secondary">
                                                <i class="fa fa-sync"></i> Sync Session
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Server Action to open Dashboard -->
        <record id="action_amp_project_dashboard" model="ir.actions.act_window">
            <field name="name">Project Dashboard</field>
            <field name="res_model">amp.project</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_amp_project_dashboard"/>
        </record>
    </data>
</odoo>
