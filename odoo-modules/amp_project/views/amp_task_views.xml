<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Task Tree View -->
        <record id="view_amp_task_tree" model="ir.ui.view">
            <field name="name">amp.task.tree</field>
            <field name="model">amp.task</field>
            <field name="arch" type="xml">
                <list string="Tasks" 
                      decoration-muted="state == 'blocked'" 
                      decoration-success="state == 'completed'"
                      decoration-info="state == 'in_progress'"
                      decoration-warning="state == 'review'">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="project_id"/>
                    <field name="story_id"/>
                    <field name="state" widget="badge"/>
                    <field name="is_ready"/>
                    <field name="agent_id"/>
                    <field name="dag_level"/>
                    <field name="dag_critical_path"/>
                    <field name="priority" widget="priority"/>
                    <field name="planned_hours"/>
                </list>
            </field>
        </record>
        
        <!-- Task Form View -->
        <record id="view_amp_task_form" model="ir.ui.view">
            <field name="name">amp.task.form</field>
            <field name="model">amp.task</field>
            <field name="arch" type="xml">
                <form string="Task">
                    <header>
                        <button name="action_dispatch" string="Dispatch" type="object" class="oe_highlight" invisible="state != 'ready'"/>
                        <button name="action_start" string="Start" type="object" class="oe_highlight" invisible="state != 'ready'"/>
                        <button name="action_mark_review" string="Submit for Review" type="object" invisible="state != 'in_progress'"/>
                        <button name="action_complete" string="Complete" type="object" class="oe_highlight" invisible="state == 'completed'"/>
                        <button name="action_block" string="Block" type="object" class="btn-warning" invisible="state == 'blocked'"/>
                        <button name="action_return_to_backlog" string="Return to Backlog" type="object" invisible="state not in ['in_progress', 'review', 'blocked']"/>
                        <field name="state" widget="statusbar" 
                               statusbar_visible="backlog,ready,in_progress,review,completed"
                               statusbar_colors='{"blocked": "red"}'/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Task Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="project_id"/>
                                <field name="epic_id"/>
                                <field name="story_id"/>
                            </group>
                            <group>
                                <field name="priority" widget="priority"/>
                                <field name="is_ready"/>
                                <field name="dag_level"/>
                                <field name="dag_critical_path"/>
                                <field name="planned_hours"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Instructions">
                                <field name="description" widget="html" options="{'style-inline': true}"/>
                            </page>
                            <page string="Acceptance Criteria">
                                <field name="acceptance_criteria"/>
                            </page>
                            <page string="Dependencies (DAG)">
                                <group>
                                    <field name="dependency_ids" widget="many2many_tags" 
                                           domain="[('project_id', '=', project_id), ('id', '!=', id)]"/>
                                    <field name="blocked_ids" widget="many2many_tags" readonly="1"/>
                                    <field name="dependency_count"/>
                                    <field name="blocked_count"/>
                                </group>
                            </page>
                            <page string="Agent Assignment">
                                <group>
                                    <field name="agent_id"/>
                                    <field name="agent_session"/>
                                    <field name="dispatch_time"/>
                                    <field name="completion_time"/>
                                </group>
                                <field name="context_data"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        
        <!-- Task Kanban - Grouped by State for workflow view -->
        <record id="view_amp_task_kanban" model="ir.ui.view">
            <field name="name">amp.task.kanban</field>
            <field name="model">amp.task</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state">
                    <field name="name"/>
                    <field name="state"/>
                    <field name="is_ready"/>
                    <field name="agent_id"/>
                    <field name="dag_level"/>
                    <field name="dag_critical_path"/>
                    <field name="priority"/>
                    <templates>
                        <t t-name="card">
                            <div t-attf-class="oe_kanban_card #{record.dag_critical_path.raw_value ? 'o_amp_critical_path' : ''}">
                                <div class="o_kanban_record_top">
                                    <strong><field name="name"/></strong>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div>
                                        <span t-if="record.agent_id.value" class="badge bg-info">
                                            <i class="fa fa-robot"></i> <field name="agent_id"/>
                                        </span>
                                        <span t-if="record.is_ready.raw_value" class="badge bg-success">Ready</span>
                                        <span t-if="record.dag_critical_path.raw_value" class="badge bg-warning">Critical Path</span>
                                    </div>
                                    <div class="mt-2">
                                        <span class="text-muted">Level: <field name="dag_level"/></span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        
        <!-- Task Search View -->
        <record id="view_amp_task_search" model="ir.ui.view">
            <field name="name">amp.task.search</field>
            <field name="model">amp.task</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <filter string="Backlog" name="backlog" domain="[('state', '=', 'backlog')]"/>
                    <filter string="Ready" name="ready" domain="[('state', '=', 'ready')]"/>
                    <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                    <filter string="Blocked" name="blocked" domain="[('state', '=', 'blocked')]"/>
                </search>
            </field>
        </record>
        
        <!-- Task Action -->
        <record id="action_amp_task" model="ir.actions.act_window">
            <field name="name">Tasks</field>
            <field name="res_model">amp.task</field>
            <field name="view_mode">kanban,list,form</field>
        </record>
    </data>
</odoo>
