<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- ── Client action: AMP Live Board ─────────────────────────────── -->
        <record id="action_amp_live_board" model="ir.actions.client">
            <field name="name">AMP Live Board</field>
            <field name="tag">amp_board_action</field>
        </record>

        <!-- ── Root menu ──────────────────────────────────────────────────── -->
        <menuitem id="menu_amp_root" name="AMP" sequence="10"
                  web_icon="amp_project,static/description/icon.png"/>

        <!-- Live Board (first item — most important) -->
        <menuitem id="menu_amp_live_board" name="⚡ Live Board"
                  parent="menu_amp_root" sequence="1"
                  action="action_amp_live_board"/>

        <!-- ── Projects ───────────────────────────────────────────────────── -->
        <menuitem id="menu_amp_projects" name="Projects"
                  parent="menu_amp_root" sequence="10"/>
        <menuitem id="menu_amp_project_list" name="All Projects"
                  parent="menu_amp_projects" sequence="10"
                  action="action_amp_project"/>

        <!-- ── Work Items ─────────────────────────────────────────────────── -->
        <menuitem id="menu_amp_work" name="Work Items"
                  parent="menu_amp_root" sequence="20"/>
        <menuitem id="menu_amp_epics" name="Epics"
                  parent="menu_amp_work" sequence="10"
                  action="action_amp_epic"/>
        <menuitem id="menu_amp_stories" name="Stories"
                  parent="menu_amp_work" sequence="20"
                  action="action_amp_story"/>
        <menuitem id="menu_amp_tasks" name="Tasks"
                  parent="menu_amp_work" sequence="30"
                  action="action_amp_task"/>
    </data>
</odoo>
