<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Story Tree View -->
        <record id="view_amp_story_tree" model="ir.ui.view">
            <field name="name">amp.story.tree</field>
            <field name="model">amp.story</field>
            <field name="arch" type="xml">
                <list string="Stories" decoration-muted="state == 'blocked'" decoration-success="state == 'completed'">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="project_id"/>
                    <field name="epic_id"/>
                    <field name="state" widget="badge"/>
                    <field name="is_ready"/>
                    <field name="task_count"/>
                    <field name="progress_percentage" widget="progressbar"/>
                    <field name="priority" widget="priority"/>
                </list>
            </field>
        </record>
        
        <!-- Story Form View -->
        <record id="view_amp_story_form" model="ir.ui.view">
            <field name="name">amp.story.form</field>
            <field name="model">amp.story</field>
            <field name="arch" type="xml">
                <form string="Story">
                    <header>
                        <button name="action_mark_ready" string="Mark Ready" type="object" class="oe_highlight" invisible="state != 'backlog' or not is_ready"/>
                        <button name="action_start" string="Start" type="object" class="oe_highlight" invisible="state not in ('backlog', 'ready')"/>
                        <button name="action_mark_review" string="Submit for Review" type="object" invisible="state != 'in_progress'"/>
                        <button name="action_complete" string="Complete" type="object" class="oe_highlight" invisible="state == 'completed'"/>
                        <button name="action_block" string="Block" type="object" class="btn-warning" invisible="state == 'blocked'"/>
                        <button name="action_unblock" string="Unblock" type="object" invisible="state != 'blocked'"/>
                        <field name="state" widget="statusbar" statusbar_visible="backlog,ready,in_progress,review,completed"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_tasks" type="object" class="oe_stat_button" icon="fa-tasks">
                                <field name="task_count" widget="statinfo" string="Tasks"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Story Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="project_id"/>
                                <field name="epic_id"/>
                                <field name="description"/>
                            </group>
                            <group>
                                <field name="priority" widget="priority"/>
                                <field name="is_ready"/>
                                <field name="progress_percentage" widget="progressbar"/>
                                <field name="planned_hours"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Acceptance Criteria">
                                <field name="acceptance_criteria"/>
                            </page>
                            <page string="Dependencies">
                                <field name="dependency_ids"/>
                                <field name="blocked_ids" readonly="1"/>
                            </page>
                            <page string="Tasks">
                                <field name="task_ids" context="{'default_story_id': id, 'default_project_id': project_id, 'default_epic_id': epic_id}">
                                    <list>
                                        <field name="name"/>
                                        <field name="state"/>
                                        <field name="agent_id"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Story Kanban -->
        <record id="view_amp_story_kanban" model="ir.ui.view">
            <field name="name">amp.story.kanban</field>
            <field name="model">amp.story</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state">
                    <field name="name"/>
                    <field name="state"/>
                    <field name="task_count"/>
                    <field name="is_ready"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_card">
                                <div class="o_kanban_record_top">
                                    <strong><field name="name"/></strong>
                                    <span t-if="record.is_ready.raw_value" class="badge bg-success">Ready</span>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="progress_percentage" widget="progressbar"/>
                                    <span class="badge bg-info"><field name="task_count"/> Tasks</span>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        
        <!-- Story Action -->
        <record id="action_amp_story" model="ir.actions.act_window">
            <field name="name">Stories</field>
            <field name="res_model">amp.story</field>
            <field name="view_mode">kanban,list,form</field>
        </record>
    </data>
</odoo>
