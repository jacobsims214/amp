{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "amp-manager",
  "provider": {
    "LlamaBarn": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:2276/v1"
      },
      "models": {
        "gpt-oss-20b": {},
        "gemma-4-31b-q4": {},
        "qwen-3.5-medium-35b-a3b": {},
        "qwen-3.6-35b-a3b": {}
      }
    }
  },
  "mcp": {
    "amp": {
      "type": "remote",
      "url": "http://localhost:8000/sse",
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/sse",
      "enabled": true
    }
  }
}
