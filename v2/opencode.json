{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "amp-manager",
  "provider": {
    "LlamaBarn": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:2276/v1"
      },
      "models": {
        "gpt-oss-20b": {},
        "gemma-4-31b-q4": {},
        "qwen-3.5-medium-35b-a3b": {},
        "qwen-3.6-35b-a3b": {}
      }
    },
    "agentic-flywheel": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Agentic Flywheel (Switchyard AI Gateway)",
      "options": {
        "baseURL": "https://ai-gateway.rp-tools-nonprod.rvohealth.com/v1",
        "headers": {
          "x-api-key": "{env:AGENTIC_FLYWHEEL_API_KEY}"
        }
      },
      "models": {
        "gateway": {
          "name": "Switchyard (auto: nemotron/sonnet)",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "nemotron": {
          "name": "Nemotron 3.5 Lightning (direct, no classifier)",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "sonnet": {
          "name": "Claude Sonnet 5 via Bedrock (direct, no classifier)",
          "limit": {
            "context": 200000,
            "output": 8192
          }
        }
      }
    }
  },
  "mcp": {
    "amp": {
      "type": "remote",
      "url": "http://localhost:8000/sse",
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  }
}
